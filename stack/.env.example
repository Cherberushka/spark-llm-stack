# Spark LLM stack v3 — configuration
# Copy to .env (script 07 does this automatically and syncs the keys
# from /etc/spark-llm.env). Adjust the rest by hand.

# Caddy front door:
#  :443            -> HTTPS self-signed (LAN default)
#  llm.example.com -> real domain; then remove `tls internal` from caddy/Caddyfile
SITE_ADDRESS=:443

# Browser tab name of the web UI
WEBUI_NAME=Spark LLM

# Self-registration (first user = ADMIN). Set false after creating accounts.
ENABLE_SIGNUP=true

# --- keys (auto-synced from /etc/spark-llm.env by script 04) ---
VLLM_API_KEY=
LITELLM_MASTER_KEY=
LITELLM_DB_PASSWORD=
LITELLM_REDIS_PASSWORD=
