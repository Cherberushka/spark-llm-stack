# =============================================================================
# Caddyfile — single HTTPS front door for the Spark LLM stack (v3)
#
#   /            -> Open WebUI (chat + admin panel)
#   /ops         -> static ops dashboard
#   /gateway/*   -> LiteLLM :4000  (single OpenAI-compatible API; master/virtual keys)
#   /vllm/*      -> host vLLM :8000        (direct, Bearer VLLM_API_KEY)
#   /ollama/*    -> host Ollama :11434      (embeddings; LAN-only by ufw)
# =============================================================================

:80 {
	redir https://{http.request.host}{http.request.uri} permanent
}

{$SITE_ADDRESS} {
	# Static self-signed cert generated by scripts/04-deploy-web.sh with SAN:
	# localhost, short hostname, 127.0.0.1, LAN IP. Works for IP access (no SNI).
	# Regenerate after IP change: rm -rf caddy/certs && re-run script 04.
	# For a public domain with Let's Encrypt: replace the next line with
	# nothing (remove it) and set SITE_ADDRESS=llm.example.com in stack/.env.
	tls /etc/caddy/certs/spark.crt /etc/caddy/certs/spark.key

	encode zstd gzip

	# LiteLLM UI cannot live under a subpath (Next.js emits absolute /ui/
	# redirects that drop the prefix) — it gets its own origin on :8443.
	redir /ui https://{http.request.host}:8443/ui 302
	redir /ui/ https://{http.request.host}:8443/ui 302

	handle /ops* {
		root * /srv/web
		rewrite /ops /ops-dashboard.html
		rewrite /ops/ /ops-dashboard.html
		file_server
	}

	handle_path /gateway/* {
		reverse_proxy litellm:4000
	}

	handle_path /vllm/* {
		reverse_proxy host.docker.internal:8000
	}

	handle_path /ollama/* {
		reverse_proxy host.docker.internal:11434
	}

	handle {
		reverse_proxy open-webui:8080
	}

	log {
		output stdout
		format console
	}
}

# Dedicated origin for the LiteLLM admin UI (virtual keys, spend logs):
#   https://<host>:8443/ui
:8443 {
	tls /etc/caddy/certs/spark.crt /etc/caddy/certs/spark.key
	encode zstd gzip
	reverse_proxy litellm:4000
}
